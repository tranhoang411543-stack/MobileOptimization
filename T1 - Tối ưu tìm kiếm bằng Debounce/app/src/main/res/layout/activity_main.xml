<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="true">

    <ScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Search with Debounce"
                android:textColor="@color/ink"
                android:textSize="24sp" />
            <ImageButton
                android:id="@+id/resetButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_outline"
                android:contentDescription="Làm lại phép đo"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/offCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Tắt tối ưu, nhấn để xem chi tiết yêu cầu"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="TẮT TỐI ƯU"
                    android:textColor="@color/warning"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/offMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />
            </LinearLayout>
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <LinearLayout
                android:id="@+id/onCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Bật tối ưu, nhấn để xem chi tiết yêu cầu"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="BẬT TỐI ƯU"
                    android:textColor="@color/success"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/onMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/search_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <Switch
                android:id="@+id/optimizationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bật/Tắt tối ưu Debounce"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:labelFor="@id/searchInput"
                android:text="Tìm kiếm"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/search_field"
                android:hint="Ví dụ: Android, Kotlin..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="100"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="#66778E"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Kết quả tìm kiếm"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/search_panel"
            android:orientation="vertical"
            android:padding="16dp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
